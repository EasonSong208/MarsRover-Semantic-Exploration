<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robot_mission</name>
  <version>0.1.0</version>
  <description>Read-only mission readiness checks for the Hiwonder JetRover.</description>
  <maintainer email="easonsong208@users.noreply.github.com">EasonSong208</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>lifecycle_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>nav2_common</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>tf2_ros_py</exec_depend>
  <exec_depend>xacro</exec_depend>

  <!-- Runtime dependencies of minimal_bringup.launch.py. These are supplied by
       the vendor Jetson workspace; this project does not replace their drivers. -->
  <exec_depend>controller</exec_depend>
  <exec_depend>imu_filter_madgwick</exec_depend>
  <exec_depend>jetrover_description</exec_depend>
  <exec_depend>peripherals</exec_depend>
  <exec_depend>robot_localization</exec_depend>
  <exec_depend>ros_robot_controller</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>
  <test_depend>python3-yaml</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
